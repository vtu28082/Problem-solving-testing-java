import java.io.*;
import java.util.*;

public class Solution {

    static int[] radius;
    static int[][] sparse;
    static int[] log;

    // Manacher's algorithm
    static void manacher(char[] a) {
        int n = a.length;
        radius = new int[n];

        int left = 0;
        int right = -1;

        for (int i = 0; i < n; i++) {

            int r = 0;

            if (i <= right) {
                r = Math.min(radius[left + right - i], right - i + 1);
            }

            while (i - r >= 0 &&
                   i + r < n &&
                   a[i - r] == a[i + r]) {
                r++;
            }

            radius[i] = r;

            if (i + r - 1 > right) {
                left = i - r + 1;
                right = i + r - 1;
            }

            // Convert to the useful palindrome radius
            radius[i]--;
        }
    }

    // Build Sparse Table for range maximum queries
    static void buildSparseTable() {
        int n = radius.length;

        log = new int[n + 1];

        for (int i = 2; i <= n; i++) {
            log[i] = log[i / 2] + 1;
        }

        int levels = log[n] + 1;
        sparse = new int[levels][n];

        System.arraycopy(radius, 0, sparse[0], 0, n);

        for (int k = 1; k < levels; k++) {
            int len = 1 << k;
            int half = len >> 1;

            for (int i = 0; i + len <= n; i++) {
                sparse[k][i] = Math.max(
                    sparse[k - 1][i],
                    sparse[k - 1][i + half]
                );
            }
        }
    }

    // Maximum radius in [left, right]
    static int rangeMax(int left, int right) {

        if (left > right) {
            return 0;
        }

        int length = right - left + 1;
        int k = log[length];

        return Math.max(
            sparse[k][left],
            sparse[k][right - (1 << k) + 1]
        );
    }

    static int[] circularPalindromes(String s) {

        int n = s.length();

        /*
         * Duplicate the string.
         *
         * Example:
         * abcde
         *
         * becomes:
         * abcdeabcde
         */
        char[] doubled = new char[2 * n];

        for (int i = 0; i < 2 * n; i++) {
            doubled[i] = s.charAt(i % n);
        }

        /*
         * Transform:
         *
         * abc -> #a#b#c#
         *
         * This allows us to handle odd and even
         * length palindromes with one Manacher array.
         */
        char[] transformed = new char[4 * n + 1];

        for (int i = 0; i < transformed.length; i++) {
            if (i % 2 == 0) {
                transformed[i] = '#';
            } else {
                transformed[i] = doubled[i / 2];
            }
        }

        // Find palindrome radius around every center
        manacher(transformed);

        // RMQ over the radii
        buildSparseTable();

        int[] answer = new int[n];

        /*
         * Each rotation is represented by a window
         * of n characters in the doubled string.
         */
        for (int rotation = 0; rotation < n; rotation++) {

            // Character positions in transformed string
            int left = rotation * 2 + 1;
            int right = (rotation + n - 1) * 2 + 1;

            int low = 1;
            int high = n;
            int best = 1;

            /*
             * Binary search the longest palindrome.
             */
            while (low <= high) {

                int mid = (low + high) >>> 1;

                /*
                 * For a palindrome of length mid to fit
                 * inside [left, right], its center must
                 * lie in this range.
                 */
                int centerLeft = left + mid - 1;
                int centerRight = right - mid + 1;

                if (centerLeft <= centerRight &&
                    rangeMax(centerLeft, centerRight) >= mid) {

                    best = mid;
                    low = mid + 1;

                } else {
                    high = mid - 1;
                }
            }

            answer[rotation] = best;
        }

        return answer;
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br = new BufferedReader(
            new InputStreamReader(System.in)
        );

        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();

        int[] result = circularPalindromes(s);

        StringBuilder out = new StringBuilder();

        for (int x : result) {
            out.append(x).append('\n');
        }

        System.out.print(out);
    }
}
