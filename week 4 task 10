import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer(br.readLine());
        int m = Integer.parseInt(st.nextToken());
        int n = Integer.parseInt(st.nextToken());
        int r = Integer.parseInt(st.nextToken());
        
        int[][] mat = new int[m][n];
        for (int i = 0; i < m; i++) {
            st = new StringTokenizer(br.readLine());
            for (int j = 0; j < n; j++) {
                mat[i][j] = Integer.parseInt(st.nextToken());
            }
        }
        
        int layers = Math.min(m, n) / 2;
        
        for (int d = 0; d < layers; d++) {
            int top = d, bottom = m - 1 - d;
            int left = d, right = n - 1 - d;
            
            List<Integer> elements = new ArrayList<>();
            
            // top row, left -> right
            for (int j = left; j <= right; j++) elements.add(mat[top][j]);
            // right col, top+1 -> bottom
            for (int i = top + 1; i <= bottom; i++) elements.add(mat[i][right]);
            // bottom row, right-1 -> left
            if (bottom != top) {
                for (int j = right - 1; j >= left; j--) elements.add(mat[bottom][j]);
            }
            // left col, bottom-1 -> top+1
            if (right != left) {
                for (int i = bottom - 1; i >= top + 1; i--) elements.add(mat[i][left]);
            }
            
            int len = elements.size();
            int shift = r % len;
            
            // rotate counter-clockwise: shift left by `shift`
            List<Integer> rotated = new ArrayList<>(len);
            for (int idx = 0; idx < len; idx++) {
                rotated.add(elements.get((idx + shift) % len));
            }
            
            // write back in same traversal order
            int pos = 0;
            for (int j = left; j <= right; j++) mat[top][j] = rotated.get(pos++);
            for (int i = top + 1; i <= bottom; i++) mat[i][right] = rotated.get(pos++);
            if (bottom != top) {
                for (int j = right - 1; j >= left; j--) mat[bottom][j] = rotated.get(pos++);
            }
            if (right != left) {
                for (int i = bottom - 1; i >= top + 1; i--) mat[i][left] = rotated.get(pos++);
            }
        }
        
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(mat[i][j]);
                if (j != n - 1) sb.append(' ');
            }
            sb.append('\n');
        }
        System.out.print(sb);
    }
}
